rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin' ||
        request.auth.token.email == 'gitevijay123@gmail.com'
      );
    }

    // Profiles collection: Public readable, fully manageable for registration, updates, and deletion
    match /profiles/{profileId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Users collection for Mobile Auth & MPIN verification
    // Direct client writes to mpin_hash are blocked; Backend Firebase Admin SDK manages MPIN & OTP verification
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isAdmin();
    }

    // OTP Verifications & 24-Hour Rate Limit Ledger:
    // STRICTLY SERVER-ONLY (Accessed exclusively by Node.js Backend via Firebase Admin SDK)
    match /otp_verifications/{mobileNumber} {
      allow read, write: if false;
    }

    // Deleted Profiles tracking collection
    match /deleted_profiles/{docId} {
      allow read, write, delete: if true;
    }

    // Recycle Bin items collection
    match /recycleBin/{itemId} {
      allow read, write, delete: if true;
    }

    // Trashed member photos
    match /trashedPhotos/{photoId} {
      allow read, write, delete: if true;
    }

    // Profile removal and marriage fixed requests
    match /profileRemovalRequests/{reqId} {
      allow read, write, delete: if true;
    }

    // KYC Verifications collection
    match /kyc_verifications/{kycId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.user_id == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Blocked Users Collection
    match /blocked_users/{blockId} {
      allow read: if isAuthenticated() && (resource.data.blocker_user_id == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.blocker_user_id == request.auth.uid;
      allow delete: if isAuthenticated() && (resource.data.blocker_user_id == request.auth.uid || isAdmin());
    }

    // Suspicious User Alerts
    match /suspicious_alerts/{alertId} {
      allow read, write: if isAdmin();
    }

    // Likes Collection
    match /likes/{likeId} {
      allow read, create, update, delete: if true;
    }

    // Profile Reports: Authenticated members can report; strictly Admin view and manage
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() && request.resource.data.reporterUserId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Security Logs: Read by owner or admin, immutable (no update/delete)
    match /securityLogs/{logId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // Admin Audit Logs: Strictly Admin only, immutable
    match /adminAuditLogs/{auditId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    // Site Configuration: Read by all, modified only by Admin
    match /siteConfig/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Payment & System Settings: Read by all, strictly editable by admins only
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Chat Messages
    match /chatMessages/{messageId} {
      allow read, create, update, delete: if true;
    }

    // Admin Support Messages
    match /adminSupportMessages/{messageId} {
      allow read, create, update, delete: if true;
    }

    // Payment Requests: Users can create and view their own, Admins can manage and approve
    match /paymentRequests/{requestId} {
      allow read: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Success Stories
    match /successStories/{storyId} {
      allow read: if resource.data.isApproved == true || isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // Community Ads & Business Vendors
    match /communityAds/{adId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /businessVendors/{vendorId} {
      allow read: if resource.data.status == 'approved' || isAdmin();
      allow create: if true;
      allow update: if (isAuthenticated() && resource.data.id == request.auth.uid && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'vendorBasePrice', 'platformMargin', 'customerPrice'])) || isAdmin();
      allow delete: if isAdmin();
    }

    match /business_vendors/{vendorId} {
      allow read: if resource.data.status == 'approved' || isAdmin();
      allow create: if true;
      allow update: if (isAuthenticated() && resource.data.id == request.auth.uid && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'vendorBasePrice', 'platformMargin', 'customerPrice'])) || isAdmin();
      allow delete: if isAdmin();
    }

    match /vendor_activity_logs/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    match /vendor_inquiries/{inquiryId} {
      allow read: if isAuthenticated() || isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Promo Codes: Read by authenticated, managed by Admin
    match /promoCodes/{codeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Notifications (Real-time & Lock-screen push alerts)
    match /notifications/{notifId} {
      allow read, create, update, delete: if true;
    }

    // Mutual Matches
    match /matches/{matchId} {
      allow read, create, update, delete: if true;
    }

    // Favourites / Shortlists
    match /favourites/{favId} {
      allow read, create, update, delete: if true;
    }

    // FCM Device Tokens (for lock-screen push delivery)
    match /deviceTokens/{tokenId} {
      allow read, create, update, delete: if true;
    }
  }
}
